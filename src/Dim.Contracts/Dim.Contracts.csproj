<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Dim.Contracts</PackageId>
    <Description>Dim IM Chat 框架的 protobuf 协议契约。</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" />
    <PackageReference Include="Grpc.Tools">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="Protos/dim_chat.proto" GrpcServices="None" />
  </ItemGroup>

</Project>
