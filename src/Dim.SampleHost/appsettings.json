{
  "DimChat": {
    "EndpointPrefix": "/dim",
    "HubPath": "/hub",
    "Connection": {
      "AllowMultiDeviceLogin": true,
      "RouteTtl": "7.00:00:00",
      "RouteKeyPrefix": "dim:routes"
    },
    "Storage": {
      "PostgreSqlConnectionString": "",
      "RedisConnectionString": "",
      "RedisStreamName": "dim:messages"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
